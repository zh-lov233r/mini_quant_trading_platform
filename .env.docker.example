POSTGRES_DB=quant
POSTGRES_USER=quant
POSTGRES_PASSWORD=quantpass
POSTGRES_PORT=5432

APP_NAME=Quant Backend
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY=
MASSIVE_S3_SECRET_KEY=
MASSIVE_S3_ENDPOINT=
MASSIVE_S3_BUCKET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Safe defaults for joint Quant + AgentOps development.
PAPER_TRADING_SCHEDULER_ENABLED=false
PAPER_TRADING_SCHEDULER_SUBMIT_ORDERS=false
RESEARCH_WORKER_ENABLED=false
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_MAX_TRIALS=50
QUANT_AGENT_INTEGRATION_ENABLED=false
QUANT_AGENT_SERVICE_TOKEN=
NEXT_PUBLIC_AGENTOPS_API_BASE_URL=http://localhost:8100
NEXT_PUBLIC_AGENTOPS_PROJECT_ID=

# Signal Center: explicit per-task opt-in plus operator transport/cleanup switches.
SIGNAL_SCAN_SCHEDULER_ENABLED=false
SIGNAL_REPORT_DELIVERY_ENABLED=false
SIGNAL_REPORT_RETENTION_ENABLED=false
SIGNAL_REPORT_PUBLIC_URL=http://localhost:3000
SIGNAL_SMTP_HOST=
SIGNAL_SMTP_PORT=587
SIGNAL_SMTP_FROM=
SIGNAL_SMTP_USER=
SIGNAL_SMTP_PASSWORD=
# Local processes only; containers share /app/data/signal-reports.
SIGNAL_REPORT_STORAGE_DIR=data/signal-reports
